# Copiá este archivo a .env y completá con los datos de tu Postgres local.
# NUNCA subas .env al repo (ya está en .gitignore).

# Formato: postgresql://usuario:password@host:puerto/nombre_base
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/ls_jabones_dev

# Puerto donde escucha la API Express.
PORT=3001

# Origen(es) permitidos por CORS, separados por coma. En producción: el dominio de GitHub Pages.
CORS_ORIGIN=http://localhost:5173

# Secreto para firmar los JWT del panel admin. Generar uno propio, ej:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=TU_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=7d

# Datos del único usuario admin (la vendedora), usados solo por el script de
# seed (db:seed-admin) — no son un endpoint de registro público.
ADMIN_EMAIL=vendedora@lsjabones.local
ADMIN_PASSWORD=TU_PASSWORD
ADMIN_NOTIFY_PHONE=5491100000000
